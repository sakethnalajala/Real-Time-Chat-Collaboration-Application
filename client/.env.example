# ─────────────────────────────────────────────────────────────────────────────
#  Nebula Chat — web client environment (Vite)
#  Copy to client/.env.local for local overrides. On Vercel, add these under
#  Project → Settings → Environment Variables.
#  Everything prefixed VITE_ is PUBLIC (bundled into the browser) — never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# REST API base URL.
#   Default "/api": same origin. Vite proxies it to the API in development and
#   client/vercel.json rewrites it to Render in production (first-party cookies).
#   Only set an absolute URL (https://your-api.onrender.com/api) if you are NOT using the
#   rewrite — then also set COOKIE_SAMESITE=none on the server.
VITE_API_URL=/api

# Socket.IO server URL.
#   Development: leave empty — the Vite dev server proxies WebSockets.
#   Production: your Render URL (Vercel rewrites cannot proxy WebSockets). Production builds
#   already get it from client/.env.production; a value set in Vercel overrides it.
VITE_SOCKET_URL=

VITE_APP_NAME=Nebula Chat

# Show the one-click demo accounts on the login page (the server must also have DEMO_MODE=true).
VITE_ENABLE_DEMO_LOGIN=true

# Development only: where the Vite proxy forwards /api, /uploads and /socket.io.
VITE_DEV_API_TARGET=http://localhost:5000
