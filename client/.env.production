# Public production build defaults (bundled into the browser) — never put secrets here.
# Variables set in Vercel → Project → Settings → Environment Variables take priority.

# REST goes through the client/vercel.json rewrite (first-party cookies).
VITE_API_URL=/api
# Socket.IO connects straight to Render, because Vercel rewrites cannot proxy WebSockets.
VITE_SOCKET_URL=https://real-time-chat-collaboration-application.onrender.com
