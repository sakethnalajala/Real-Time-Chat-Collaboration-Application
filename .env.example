# ─────────────────────────────────────────────────────────────────────────────
#  Nebula Chat — environment reference
#
#  Each app reads its own file:
#    server/.env        ← copy from server/.env.example   (Render: service environment)
#    client/.env.local  ← copy from client/.env.example   (Vercel: project environment)
#
#  This root file summarises the variables you MUST set for production.
#  Full, commented lists live in server/.env.example and client/.env.example.
# ─────────────────────────────────────────────────────────────────────────────

# ── server (Render) ──────────────────────────────────────────────────────────
NODE_ENV=production
# Local development uses mongodb://localhost:27017/real_time_chat (see server/.env.example).
# Production: your Atlas Cluster0 connection string; the data lives in the "real_time_chat" database.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.<id>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=real_time_chat
JWT_ACCESS_SECRET=<at least 32 random characters>
# REQUIRED: your Vercel production URL, exactly (no trailing slash). Extra URLs → CORS_ORIGINS.
CLIENT_URL=https://your-app.vercel.app
TRUST_PROXY=2
COOKIE_SAMESITE=lax
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>
# Email is optional and not used — leave SMTP empty (admins create password reset links instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DEMO_MODE=true
DEMO_USER_PASSWORD=<strong shared demo password>
DEMO_ADMIN_PASSWORD=<strong demo admin password>

# ── client (Vercel) ──────────────────────────────────────────────────────────
# Optional: client/.env.production already provides these for production builds.
VITE_API_URL=/api
VITE_SOCKET_URL=https://real-time-chat-collaboration-application.onrender.com
VITE_APP_NAME=Nebula Chat
VITE_ENABLE_DEMO_LOGIN=true
