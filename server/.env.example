# ─────────────────────────────────────────────────────────────────────────────
#  Nebula Chat — API server environment
#  Copy to server/.env for local development. On Render, add these in
#  Dashboard → your service → Environment. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development
# Render injects PORT automatically in production.
PORT=5000
APP_NAME=Nebula Chat

# Public URL of the React app (CORS + password reset links).
#   local:      http://localhost:5173
#   production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173
# Extra allowed origins, comma separated (e.g. Vercel preview URLs).
CORS_ORIGINS=

# ── Database ─────────────────────────────────────────────────────────────────
# Development: local MongoDB (Community Server / service on port 27017), database "real_time_chat".
# Production (Render): replace with your MongoDB Atlas SRV string, keeping the same variable:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/real_time_chat?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/real_time_chat
# Optional. Database used: MONGODB_DB_NAME → database named in the URI → real_time_chat.
# (Atlas connection strings usually have no database name; the app then uses real_time_chat.)
MONGODB_DB_NAME=

# ── Authentication ───────────────────────────────────────────────────────────
# REQUIRED in production: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Refresh-token cookie. Keep "lax" when the frontend proxies /api through Vercel (recommended).
# Use "none" only if the browser calls the Render URL directly (cross-site).
COOKIE_SAMESITE=lax
# Defaults to true in production.
COOKIE_SECURE=
# Number of proxies in front of the app (Render = 1; Render behind Vercel rewrites = 2).
TRUST_PROXY=

# ── File storage ─────────────────────────────────────────────────────────────
# auto (default) → Cloudinary when all three CLOUDINARY_* values below are set,
#                  local disk in development otherwise, uploads disabled in production.
# cloudinary | local | disabled
STORAGE_DRIVER=auto
# Cloudinary console → Settings → API Keys. Server-side only: the API secret is never
# sent to the browser. On Render, add these as environment variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nebula-chat
# Only for STORAGE_DRIVER=local when files must be served from an absolute URL.
PUBLIC_SERVER_URL=
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_MESSAGE=5

# ── Email (optional — not required) ──────────────────────────────────────────
# Leave SMTP empty: the app runs and deploys without any email service.
# Password resets without email:
#   • development  → the reset link is shown on the Forgot Password page and printed here
#   • production   → an admin creates a single-use reset link (Admin → Users → user → Reset link)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nebula Chat <no-reply@example.com>
PASSWORD_RESET_TTL_MINUTES=30

# ── Demo accounts ────────────────────────────────────────────────────────────
# When true, the 4 demo accounts are created on startup and the login page shows
# one-click "Use demo account" sign-in for Demo User and Demo Admin (passwords are never
# sent to the browser). Demo accounts cannot change their password, and the demo
# admin can only manage demo accounts. Defaults to true in development, false in production.
DEMO_MODE=true
DEMO_USER1_EMAIL=aarav.demo@example.com
DEMO_USER2_EMAIL=maya.demo@example.com
DEMO_USER3_EMAIL=liam.demo@example.com
DEMO_ADMIN_EMAIL=admin.demo@example.com
# Set strong values to also allow email + password sign-in (e.g. for Postman).
# If empty, random passwords are generated (one-click demo login still works).
DEMO_USER_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_SEED_SAMPLE_DATA=true

# debug | info | warn | error
LOG_LEVEL=
