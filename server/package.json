{
  "name": "nebula-chat-server",
  "version": "1.0.0",
  "private": true,
  "description": "Nebula Chat API — Express, MongoDB/Mongoose, Socket.IO",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db": "node src/scripts/dev-db.js",
    "seed": "node --env-file-if-exists=.env src/scripts/seed.js",
    "seed:reset": "node --env-file-if-exists=.env src/scripts/seed.js --reset",
    "check:cloudinary": "node --env-file-if-exists=.env src/scripts/check-cloudinary.js",
    "test": "node node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
